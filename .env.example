# Copy to .env for local dev, and set these in Vercel → Project → Settings → Environment Variables for production.

# Your Anthropic API key from https://console.anthropic.com  (server-side only — never exposed to the browser)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# The family PIN your son types once on his device. Choose any short string.
APP_PIN=1234

# Optional — the model to use. Defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=claude-sonnet-5
